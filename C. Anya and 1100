using namespace std;
#define int long long
#define mod 1000000007

void solve() {
  string s;
  cin >> s;
  map<int, int> mp;
  int n = s.size();
  for (int i = 0; i + 3 < (int)s.size(); i++) {
    if (s[i] == '1' and s[i + 1] == '1' and s[i + 2] == '0' and s[i + 3] == '0') {
      mp[i] = 1;
    }
  }
  int q;
  cin >> q;
  while(q--) {
    int i, v;
    cin >> i >> v;
    i--;
    if (n < 3) {
      cout << "NO" << endl;
      return;
    }
    if (v == 1) {
      s[i] = '1';
      if (i + 3 < n and s[i + 1] == '1' and s[i + 2] == '0' and s[i + 3] == '0') {
        mp[i] = 1;
      }
      else if (i - 1 >= 0 and i + 2 < n and s[i - 1] == '1' and s[i + 1] == '0' and s[i + 2] == '0') {
        mp[i - 1] = 1;
      }
      if (mp.count(i - 2)) {
        mp.erase(i - 2);
      } 
      if (mp.count(i - 3)) {
        mp.erase(i - 3);
      }
      if (mp.size() > 0) {
        cout << "YES" << endl;
      }
      else cout << "NO" << endl;
    }
    else {
      s[i] = '0';
      if (i - 3 >= 0 and s[i - 1] == '0' && s[i - 2] == '1' && s[i - 3] == '1') {
        mp[i - 3] = 1;
      }
      else if (i + 1 < n and i - 2 >= 0 and s[i + 1] == '0' and s[i - 1] == '1' and s[i - 2] == '1') {
        mp[i - 2] = 1;
      }

      if (mp.count(i)) {
        mp.erase(i);
      }
      if (mp.count(i - 1)) {
        mp.erase(i - 1);
      }
      if (mp.size() > 0) {
        cout << "YES" << endl;
      }
      else {
        cout << "NO" << endl;
      }
    }
  }
}

int32_t main() {
  ios::sync_with_stdio(false);
  cin.tie(0);
  cout.tie(0);
  int t;
  cin >> t;
  // t = 1;
  while (t--) {
    solve();
  }
  return 0;
}
